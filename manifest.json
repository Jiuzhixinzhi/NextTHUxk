{
  "manifest_version": 3,
  "name": "NextTHUxk",
  "short_name": "NextTHUxk",
  "version": "1.3.16",
  "description": "下一代选课 - 基于 AI 决策与现代双栏 UI 的选课无感辅助系统。",
  "permissions": ["activeTab", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://webvpn.tsinghua.edu.cn/*",
    "https://zhjw.cic.tsinghua.edu.cn/*",
    "https://zhjwxk.cic.tsinghua.edu.cn/*",
    "http://zhjw.cic.tsinghua.edu.cn/*",
    "http://zhjwxk.cic.tsinghua.edu.cn/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://webvpn.tsinghua.edu.cn/*",
      "https://zhjw.cic.tsinghua.edu.cn/*",
      "https://zhjwxk.cic.tsinghua.edu.cn/*",
      "http://zhjw.cic.tsinghua.edu.cn/*",
      "http://zhjwxk.cic.tsinghua.edu.cn/*"
    ],
    "js": [
      "src/config.js",
      "src/data.js",
      "src/probability.js",
      "src/state.js",
      "src/render.js",
      "src/ai.js",
      "src/update.js",
      "content.js"
    ],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["content.css"],
    "matches": ["<all_urls>"]
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "nextthuxk@smartthise.github.io",
      "strict_min_version": "115.0"
    },
    "gecko_android": {}
  },
  "data_collection_permissions": {
    "collaborators": [],
    "extension_apis": [],
    "network_capabilities": [],
    "permissions": [],
    "surface": "all"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NextTHUxk"
  }
}
