{
  "manifest_version": 3,
  "name": "NextTHUxk",
  "short_name": "NextTHUxk",
  "version": "3.3.0",
  "description": "下一代选课 - 双栏选课工作台：随时查询、草稿编排、中签概率与学分模拟。",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://webvpn.tsinghua.edu.cn/*",
    "https://zhjw.cic.tsinghua.edu.cn/*",
    "https://zhjwxk.cic.tsinghua.edu.cn/*",
    "http://zhjw.cic.tsinghua.edu.cn/*",
    "http://zhjwxk.cic.tsinghua.edu.cn/*",
    "https://thubook.help/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://webvpn.tsinghua.edu.cn/*",
        "https://zhjw.cic.tsinghua.edu.cn/*",
        "https://zhjwxk.cic.tsinghua.edu.cn/*",
        "http://zhjw.cic.tsinghua.edu.cn/*",
        "http://zhjwxk.cic.tsinghua.edu.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nextthuxk@guojl06.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    },
    "gecko_android": {}
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NextTHUxk",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
